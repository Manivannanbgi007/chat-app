# PRODUCTION settings. Create the real file with:   bash infra/init-env.sh prod     (random passwords, then edit the rest)
# Never commit infra/.env.prod. Keep a copy in your password manager: without these values the data cannot be used.
# Explanation of every value: DEPLOYMENT_GUIDE.md

# ---- Where it runs ----
# DNS: DOMAIN and files.DOMAIN must both point to this server.
DOMAIN=chat.example.com
# Let's Encrypt contact (one line, keep the word "email"). For a test on your own computer use:  local_certs
CADDY_GLOBAL=email admin@example.com
# The public IP address of this server (Coturn announces it so browsers can reach the relay)
TURN_EXTERNAL_IP=203.0.113.10
TURN_PUBLIC_HOST=chat.example.com

# Browser addresses (CORS, links in e-mails, links to uploaded files)
PUBLIC_BASE_URL=https://chat.example.com
PUBLIC_ORIGINS=https://chat.example.com
S3_PUBLIC_ENDPOINT=https://files.chat.example.com

# ---- Images (set by the release workflow; to roll back, put the previous tag here and run infra/deploy.sh) ----
IMAGE_PREFIX=ghcr.io/your-account/chat-app
IMAGE_TAG=v0.1.0

# ---- Switches that must be false in production ----
SWAGGER_ENABLED=false

# ---- E-mail (verification codes, password reset). Use your provider's SMTP settings, for example Amazon SES ----
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=CHANGE_ME_SMTP_USER
MAIL_PASSWORD=CHANGE_ME_SMTP_PASSWORD
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true
MAIL_FROM=no-reply@chat.example.com

# ---- Secrets (init-env.sh prod fills every CHANGE_ME with a random value, except the two SMTP lines above) ----
MYSQL_ROOT_PASSWORD=CHANGE_ME
AUTH_DB_PASSWORD=CHANGE_ME
USER_DB_PASSWORD=CHANGE_ME
CONVERSATION_DB_PASSWORD=CHANGE_ME
MESSAGE_DB_PASSWORD=CHANGE_ME
MEDIA_DB_PASSWORD=CHANGE_ME
NOTIFICATION_DB_PASSWORD=CHANGE_ME
CALL_DB_PASSWORD=CHANGE_ME
STATUS_DB_PASSWORD=CHANGE_ME
REDIS_PASSWORD=CHANGE_ME
S3_ACCESS_KEY=CHANGE_ME
S3_SECRET_KEY=CHANGE_ME
JWT_SECRET=CHANGE_ME
INTERNAL_SERVICE_TOKEN=CHANGE_ME
TURN_SECRET=CHANGE_ME
GRAFANA_ADMIN_PASSWORD=CHANGE_ME

# Passphrase that encrypts the backups (infra/backup/backup.sh). LOSE IT = THE BACKUPS ARE USELESS.
BACKUP_PASSPHRASE=CHANGE_ME
