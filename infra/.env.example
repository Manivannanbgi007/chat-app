# Copy to .env and fill in values, or run:  bash infra/init-env.sh
# (init-env.sh creates .env with random passwords). Never commit .env.

# ---- MySQL (one server locally, one database + one user per service) ----
MYSQL_ROOT_PASSWORD=CHANGE_ME
AUTH_DB_PASSWORD=CHANGE_ME
USER_DB_PASSWORD=CHANGE_ME
CONVERSATION_DB_PASSWORD=CHANGE_ME
MESSAGE_DB_PASSWORD=CHANGE_ME
MEDIA_DB_PASSWORD=CHANGE_ME
NOTIFICATION_DB_PASSWORD=CHANGE_ME
CALL_DB_PASSWORD=CHANGE_ME
STATUS_DB_PASSWORD=CHANGE_ME

# ---- Redis ----
REDIS_PASSWORD=CHANGE_ME

# ---- Local S3 storage (RustFS, S3 compatible) ----
S3_ACCESS_KEY=chatapp_s3_access
S3_SECRET_KEY=CHANGE_ME

# ---- Application security ----
# At least 32 characters. Used to sign JWT access tokens (Phase 2).
JWT_SECRET=CHANGE_ME

# Shared by all services for calls between them (header X-Internal-Token). Never routed by the gateway.
INTERNAL_SERVICE_TOKEN=CHANGE_ME

# Shared by Coturn (TURN server for calls, Phase 7) and call-signaling-service, which makes short-lived TURN
# passwords from it. At least 16 characters. init-env.sh replaces CHANGE_ME with a random value.
TURN_SECRET=CHANGE_ME

# Password of the Grafana "admin" user (monitoring, Phase 9: docker-compose.monitoring.yml).
GRAFANA_ADMIN_PASSWORD=CHANGE_ME

# ---- Gateway ----
# Comma separated list of browser origins allowed to call the gateway.
CORS_ALLOWED_ORIGINS=http://localhost:5210
