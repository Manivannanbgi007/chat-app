   "title": "Warnings and errors (all services)",
   "datasource": {
    "type": "loki",
    "uid": "loki"
   },
   "gridPos": {
    "h": 10,
    "w": 24,
    "x": 0,
    "y": 36
   },
   "targets": [
    {
     "expr": "{service=~\".+\", level=~\"ERROR|WARN\"}",
     "refId": "A",
     "datasource": {
      "type": "loki",
      "uid": "loki"
     },
     "queryType": "range"
    }
   ],
   "options": {
    "showTime": true,
    "wrapLogMessage": true,
    "enableLogDetails": true,
    "sortOrder": "Descending"
   }
