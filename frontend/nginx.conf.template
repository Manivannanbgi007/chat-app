# Used inside the frontend container (listens on port 8080, runs as a normal user, not root).
# The nginx image replaces ${S3_PUBLIC_ORIGIN} with the environment variable of the same name when the container
# starts (only variables that exist in the environment are replaced, so $host and friends stay untouched).
# This file is loaded inside nginx's "http" block, so "map" is allowed here.

# Sets the Connection header to "upgrade" for WebSocket requests, "close" otherwise.
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 8080;
    server_name _;
    server_tokens off;            # do not tell the world which nginx version this is

    root /usr/share/nginx/html;
    index index.html;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;
    gzip_min_length 1024;

    # Security headers for every response (the same list is included again in locations that set their own headers,
    # because nginx drops inherited add_header lines there).
    include /etc/nginx/conf.d/snippets/security-headers.conf;

    # REST calls go to the API gateway.
    location /api/ {
        # File uploads (images, videos, documents, voice notes) are up to 100 MB. nginx would refuse anything over
        # 1 MB by default, so allow a little more than the biggest file the server accepts. The size rules of
        # each file type are enforced by media-service.
        client_max_body_size 110m;
        # stream the upload to the gateway instead of storing it in nginx first, and allow a slow connection
        proxy_request_buffering off;
        proxy_send_timeout 160s;
        proxy_read_timeout 160s;
        proxy_pass http://api-gateway:8200;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # WebSocket (STOMP) connections also go to the gateway. The browser connects to "/ws" WITHOUT a trailing
    # slash; a plain "location /ws/" would answer that with a 301 redirect, which a WebSocket cannot follow.
    location ~ ^/ws(/|$) {
        proxy_pass http://api-gateway:8200;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_read_timeout 3600s;   # keep idle sockets open
    }

    # Built asset files have hashed names, so browsers can cache them for a long time.
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        include /etc/nginx/conf.d/snippets/security-headers.conf;
    }

    # The page itself must never be cached for long, otherwise users keep an old version that points to
    # asset files that no longer exist.
    location = /index.html {
        add_header Cache-Control "no-cache";
        include /etc/nginx/conf.d/snippets/security-headers.conf;
    }

    # Single-page app: unknown paths return index.html and React Router takes over.
    location / {
        try_files $uri $uri/ /index.html;
        add_header Cache-Control "no-cache";
        include /etc/nginx/conf.d/snippets/security-headers.conf;
    }
}
